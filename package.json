{
  "name": "wedding-moments",
  "private": true,
  "version": "1.0.0",
  "description": "Guest photo & video sharing for a wedding: scan QR → upload → see your moments. Vue + Supabase, no custom backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "rls-test": "node --env-file=.env scripts/rls-test.mjs",
    "qr-card": "node scripts/qr-card.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@supabase/supabase-js": "2.119.2",
    "tus-js-client": "4.3.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "happy-dom": "21.0.4",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
